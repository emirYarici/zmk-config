#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// | ESC/~ |  1  |  2  |  3  |  4  |  5  |           |  6  |  7  |  8  |  9  |  0  | BKSP |
// |  TAB  |  Q  |  W  |  E  |  R  |  T  |           |  Y  |  U  |  I  |  O  |  P  |  \   |
// | CAPS  |  A  |  S  |  D  |  F  |  G  |           |  H  |  J  |  K  |  L  |  ;  | ENT  |
// | SHIFT |  Z  |  X  |  C  |  V  |  B  |           |  N  |  M  |  ,  |  .  |  /  |  '   |
// | CTRL  | OPT | CMD | CMD | SPC | FN  |           | FN  | SPC | LFT | DWN |  UP | RGT  |
                        bindings = <
   &gresc     &kp N1    &kp N2    &kp N3     &kp N4     &kp N5               &kp N6     &kp N7  &kp N8     &kp N9    &kp N0    &kp BSPC
   &kp TAB    &kp Q     &kp W     &kp E      &kp R      &kp T                &kp Y      &kp U   &kp I      &kp O     &kp P     &kp BSLH
   &kp CAPS   &kp A     &kp S     &kp D      &kp F      &kp G                &kp H      &kp J   &kp K      &kp L     &kp SEMI  &kp RET
   &kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B                &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp SQT
   &kp LCTRL  &kp LALT  &kp LGUI  &kp LGUI   &kp SPACE  &mo 1                &mo 1      &kp SPACE &kp LEFT &kp DOWN  &kp UP    &kp RIGHT
                        >;
                };

                lower_layer {
// --------------------------------------------------------------------------------------------------------------------
// |   `   |  BRI-  |  BRI+  |   F3   |   F4   |   F5   |          |   F6  |  PREV |  PLAY |  NEXT |   MUTE   |  DEL  |
// |       |  BT 1  |  BT 2  |  BT 3  |  BT 4  |  BT 5  |          |       |   _   |   +   |   {   |    }     | BTCLR |
// |       |        |        |   (    |   )    |        |          |       |   -   |   =   |   [   |    ]     |       |
// | SHIFT |        |        |        |        |        |          |       |       |       |       |   VOL-   | VOL+  |
// |       |        |        |        |        |        |          |       |       |  HOME | PGDN  |   PGUP   |  END  |
                        bindings = <
   &kp GRAVE &kp C_BRI_DN &kp C_BRI_UP &kp F3       &kp F4       &kp F5         &kp F6    &kp C_PREV &kp C_PP  &kp C_NEXT &kp C_MUTE   &kp DEL
   &trans    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans    &kp UNDER  &kp PLUS  &kp LBRC   &kp RBRC     &bt BT_CLR
   &trans    &trans       &trans       &kp LPAR     &kp RPAR     &trans         &trans    &kp MINUS  &kp EQUAL &kp LBKT   &kp RBKT     &trans
   &kp LSHFT &trans       &trans       &trans       &trans       &trans         &trans    &trans     &trans    &trans     &kp C_VOL_DN &kp C_VOL_UP
   &trans    &trans       &trans       &trans       &trans       &trans         &trans    &trans     &kp HOME  &kp PG_DN  &kp PG_UP    &kp END
                        >;
                };
        };
};
